#!/usr/bin/env bash

set -u

echo "============================================================"
echo "Kenchiku Form Sandbox Diagnostics"
echo "============================================================"

echo
echo "DATE:"
date -u || true

echo
echo "USER:"
whoami || true

echo
echo "PWD:"
pwd || true

echo
echo "OS:"
cat /etc/os-release || true

echo
echo "PYTHON:"
python --version || true
which python || true

echo
echo "LIBREOFFICE:"
which libreoffice || true
libreoffice --version || true

echo
echo "POPPLER:"
which pdftotext || true
pdftotext -v 2>&1 | head -n 2 || true

echo
echo "TESSERACT:"
which tesseract || true
tesseract --version 2>&1 | head -n 2 || true

echo
echo "TESSERACT LANGUAGES:"
tesseract --list-langs 2>&1 || true

echo
echo "IMAGEMAGICK:"
which identify || true
identify -version 2>&1 | head -n 2 || true

echo
echo "PYTHON PACKAGES:"

python - <<'PY'
packages = [
  "openpyxl",
  "xlrd",
  "xlwt",
  "xlutils",
  "pandas",
  "pypdf",
  "pdfplumber",
  "docx",
  "pptx",
  "odf",
  "PIL",
]

for package in packages:
  try:
    module = __import__(package)
    version = getattr(module, "__version__", "unknown")
    print(f"{package}: {version}")
  except Exception as exc:
    print(f"{package}: NOT AVAILABLE ({exc})")

PY

echo
echo "COMMANDS:"
for command in \
  form-inspect \
  form-convert \
  form-verify \
  inspect_excel
do
  printf "%-20s " "$command"

  if command -v "$command" >/dev/null 2>&1; then
    echo "AVAILABLE: $(command -v "$command")"
  else
    echo "MISSING"
  fi
done

echo
echo "============================================================"
echo "Diagnostics complete"
echo "============================================================"