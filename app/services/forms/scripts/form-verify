#!/usr/bin/env python3
"""
form-verify <file>

Sanity-checks that an output document is well-formed and openable.
Pure-Python -- no system packages required.
"""

import subprocess
import sys
from pathlib import Path

import fitz  # PyMuPDF
from PIL import Image

INSPECT_EXCEL_PATH = "/home/vercel-sandbox/.local/bin/inspect_excel.py"


def verify_spreadsheet(path: Path) -> None:
  subprocess.run(
    [sys.executable, INSPECT_EXCEL_PATH, str(path)],
    check=True, capture_output=True,
  )
  print("Spreadsheet verification passed.")


def verify_pdf(path: Path) -> None:
  document = fitz.open(path)
  if document.page_count < 1:
    raise RuntimeError("PDF has zero pages.")
  document.close()
  print("PDF verification passed.")


def verify_docx(path: Path) -> None:
  from docx import Document
  Document(path)
  print("DOCX verification passed.")


def verify_pptx(path: Path) -> None:
  from pptx import Presentation
  Presentation(path)
  print("PPTX verification passed.")


def verify_image(path: Path) -> None:
  with Image.open(path) as img:
    img.verify()
  print("Image verification passed.")


HANDLERS = {
  "xls": verify_spreadsheet,
  "xlsx": verify_spreadsheet,
  "xlsm": verify_spreadsheet,
  "pdf": verify_pdf,
  "docx": verify_docx,
  "pptx": verify_pptx,
  "png": verify_image,
  "jpg": verify_image,
  "jpeg": verify_image,
  "tif": verify_image,
  "tiff": verify_image,
  "bmp": verify_image,
  "webp": verify_image,
}


def main() -> None:
  if len(sys.argv) != 2:
    print("Usage: form-verify <file>", file=sys.stderr)
    sys.exit(1)

  path = Path(sys.argv[1]).resolve()
  if not path.exists():
    print(f"File does not exist: {path}", file=sys.stderr)
    sys.exit(1)

  print("Verifying:")
  print(path)
  print()

  extension = path.suffix.lower().lstrip(".")
  handler = HANDLERS.get(extension)

  if handler is None:
    print("Basic file verification passed.")
    return

  handler(path)


if __name__ == "__main__":
  main()