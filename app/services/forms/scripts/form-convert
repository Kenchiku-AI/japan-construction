#!/usr/bin/env python3
"""
form-convert <input-file> <output-directory>

Converts office documents locally using LibreOffice.

No files are sent to a third-party conversion service.

Supported conversions:

  .xls  -> .xlsx
  .xlsx -> .xls
  .xlsm -> .xlsx
  .doc  -> .docx
  .docx -> .pdf
  .ppt  -> .pptx
  .pptx -> .pdf
  .ods  -> .xlsx

LibreOffice is installed into the sandbox snapshot and invoked
directly with its headless command-line interface.
"""

import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


LIBREOFFICE_BIN = os.environ.get(
  "LIBREOFFICE_BIN",
  shutil.which("libreoffice")
  or shutil.which("soffice")
  or "/usr/bin/libreoffice",
)


FORMAT_MAP = {
  "xls": "xlsx",
  "xlsx": "xls",
  "xlsm": "xlsx",
  "doc": "docx",
  "docx": "pdf",
  "ppt": "pptx",
  "pptx": "pdf",
  "ods": "xlsx",
}


def find_libreoffice() -> str:
  candidates = [
    os.environ.get("LIBREOFFICE_BIN"),
    shutil.which("libreoffice"),
    shutil.which("soffice"),
    "/usr/bin/libreoffice",
    "/usr/local/bin/libreoffice",
  ]

  for candidate in candidates:
    if candidate and Path(candidate).exists():
      return candidate

  raise RuntimeError(
    "LibreOffice was not found. "
    "Expected 'libreoffice' or 'soffice' to be installed "
    "in the sandbox snapshot."
  )


def convert_via_libreoffice(
  input_path: Path,
  output_format: str,
  output_dir: Path,
) -> Path:
  libreoffice = find_libreoffice()

  output_dir.mkdir(parents=True, exist_ok=True)

  # LibreOffice can have problems when multiple headless instances
  # share the same user profile. Give each conversion an isolated
  # temporary profile.
  with tempfile.TemporaryDirectory(
    prefix="libreoffice-profile-",
  ) as profile_dir:

    profile_uri = Path(profile_dir).resolve().as_uri()

    command = [
      libreoffice,
      "--headless",
      "--nologo",
      "--nodefault",
      "--nofirststartwizard",
      "--norestore",
      f"-env:UserInstallation={profile_uri}",
      "--convert-to",
      output_format,
      "--outdir",
      str(output_dir),
      str(input_path),
    ]

    result = subprocess.run(
      command,
      capture_output=True,
      text=True,
      timeout=120,
    )

  if result.returncode != 0:
    raise RuntimeError(
      "LibreOffice conversion failed.\n"
      f"Command: {' '.join(command)}\n"
      f"stdout:\n{result.stdout}\n"
      f"stderr:\n{result.stderr}"
    )

  output_path = output_dir / (
    f"{input_path.stem}.{output_format}"
  )

  if not output_path.exists():
    raise RuntimeError(
      "LibreOffice reported success but the expected output "
      f"was not created: {output_path}\n"
      f"stdout:\n{result.stdout}\n"
      f"stderr:\n{result.stderr}"
    )

  return output_path


def main() -> None:
  if len(sys.argv) != 3:
    print(
      "Usage: form-convert <input> <output-directory>",
      file=sys.stderr,
    )
    sys.exit(1)

  input_path = Path(sys.argv[1]).resolve()
  output_dir = Path(sys.argv[2]).resolve()

  if not input_path.exists():
    print(
      f"Input file does not exist: {input_path}",
      file=sys.stderr,
    )
    sys.exit(1)

  extension = input_path.suffix.lower().lstrip(".")

  output_format = FORMAT_MAP.get(extension)

  if output_format is None:
    print(
      f"Unsupported conversion from .{extension}",
      file=sys.stderr,
    )
    sys.exit(1)

  try:
    result_path = convert_via_libreoffice(
      input_path,
      output_format,
      output_dir,
    )
  except Exception as exc:
    print(
      f"Conversion failed: {exc}",
      file=sys.stderr,
    )
    sys.exit(1)

  print(result_path)


if __name__ == "__main__":
  main()
